{
  "name": "@ecom/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist .turbo *.tsbuildinfo",
    "test:integracion": "vitest run --config vitest.integracion.config.ts",
    "test:cobertura": "vitest run --reporter=blob --outputFile=.vitest-reports/unidad.json --coverage.enabled && vitest run --config vitest.integracion.config.ts --reporter=blob --outputFile=.vitest-reports/integracion.json --coverage.enabled && vitest --merge-reports --config vitest.cobertura.config.ts --coverage.enabled",
    "start:workers": "node dist/main.workers.js",
    "dev:workers": "nest start --watch --entryFile main.workers"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1094.0",
    "@aws-sdk/s3-request-presigner": "^3.1094.0",
    "@ecom/db": "workspace:*",
    "@ecom/payments": "workspace:*",
    "@ecom/shared": "workspace:*",
    "@ecom/suppliers": "workspace:*",
    "@fastify/compress": "^8.1.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^10.1.0",
    "@fastify/static": "^10.1.2",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-fastify": "^11.1.28",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/throttler": "^6.5.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@sentry/node": "^10.68.0",
    "argon2": "^0.44.0",
    "bullmq": "^5.81.1",
    "fastify": "^5.10.0",
    "ioredis": "^5.11.1",
    "meilisearch": "^0.60.0",
    "nestjs-pino": "^4.4.1",
    "nestjs-zod": "^5.4.0",
    "nodemailer": "^9.0.3",
    "otplib": "^13.4.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sanitize-html": "^2.17.6",
    "sharp": "^0.35.3",
    "yauzl": "^3.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.28",
    "@types/node": "^24.10.1",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/sanitize-html": "^2.16.1",
    "@types/yauzl": "^3.4.0",
    "typescript": "5.9.3",
    "vitest": "^4.1.10"
  }
}
