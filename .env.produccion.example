# ─────────────────────────────────────────────────────────────
#  Plantilla del .env de PRODUCCIÓN
#
#  Este fichero es una plantilla y va en el repositorio. El de verdad vive
#  SOLO en el servidor, en /opt/tienda/.env, con permisos 600 y sin copia en
#  ningún portátil, chat ni gestor de notas.
#
#  Cada secreto se genera EN EL SERVIDOR:
#
#      openssl rand -base64 48        # secretos de sesión y contraseñas
#      openssl rand -hex 32           # ENCRYPTION_KEY (64 caracteres hex)
#
#  La API valida esto al arrancar y se niega a levantar si detecta valores de
#  ejemplo. Es deliberado: un `cambiame` en producción es una sesión falsable.
#
#  Lo que NO va aquí: credenciales de pasarelas, proveedor y correo. Esas se
#  ponen desde Admin → Integraciones, se guardan cifradas en la base y se
#  pueden rotar sin tocar el servidor ni reiniciar nada.
# ─────────────────────────────────────────────────────────────

NODE_ENV=production

# ── Identidad del despliegue ──────────────────────────────────
# La rellena el script de despliegue; no la toques a mano.
VERSION=latest
REGISTRO=ghcr.io/TU_USUARIO/TU_REPOSITORIO

# ── Dominios ──────────────────────────────────────────────────
DOMINIO=tudominio.es
DOMINIO_API=api.tudominio.es
DOMINIO_ADMIN=admin.tudominio.es
DOMINIO_MEDIA=media.tudominio.es

# ── URLs públicas ─────────────────────────────────────────────
API_URL=https://api.tudominio.es
STOREFRONT_URL=https://tudominio.es
ADMIN_URL=https://admin.tudominio.es
# Quién puede llamar a la API desde un navegador. Sin comodines: un `*` aquí
# permite que cualquier web haga peticiones con las cookies del cliente.
CORS_ORIGINS=https://tudominio.es,https://www.tudominio.es,https://admin.tudominio.es

API_PORT=3001
API_HOST=0.0.0.0
# Detrás de Traefik. Sin esto el limitador ve una sola IP —la del proxy— y
# bloquea a toda la tienda al primer pico de tráfico.
TRUST_PROXY=true

# ── Base de datos ─────────────────────────────────────────────
# El host es el NOMBRE DEL SERVICIO en la red de Docker, no localhost.
POSTGRES_USER=ecom
POSTGRES_PASSWORD=  # openssl rand -base64 36
POSTGRES_DB=ecom
DATABASE_URL=postgresql://ecom:LA_MISMA_DE_ARRIBA@postgres:5432/ecom?schema=public
# Conexiones por proceso. El total es (réplicas de api + de workers) × esto, y
# el máximo de Postgres son 100. Ver infra/ESCALADO.md antes de subirlo.
DATABASE_POOL_SIZE=10

# ── Redis ─────────────────────────────────────────────────────
REDIS_PASSWORD=  # openssl rand -base64 36
REDIS_URL=redis://:LA_MISMA_DE_ARRIBA@redis:6379

# ── Buscador ──────────────────────────────────────────────────
MEILI_HOST=http://meilisearch:7700
MEILI_MASTER_KEY=  # openssl rand -base64 36

# ── Almacenamiento de imágenes ────────────────────────────────
S3_ENDPOINT=http://minio:9000
S3_REGION=eu-west-1
S3_ACCESS_KEY=  # openssl rand -base64 24
S3_SECRET_KEY=  # openssl rand -base64 36
S3_BUCKET=ecom-media
S3_BUCKET_PRIVATE=ecom-private
S3_FORCE_PATH_STYLE=true
# La URL con la que el navegador del cliente pide las imágenes: dominio
# público, no el nombre interno del contenedor.
S3_PUBLIC_URL=https://media.tudominio.es/ecom-media

# ── Secretos de sesión ────────────────────────────────────────
# Mínimo 32 caracteres cada uno. Cambiar JWT_ACCESS_SECRET cierra la sesión de
# todo el mundo; para rotar sin echar a nadie, pon el anterior en _PREVIOUS
# durante un par de días.
JWT_ACCESS_SECRET=   # openssl rand -base64 48
JWT_REFRESH_SECRET=  # openssl rand -base64 48
JWT_ACCESS_SECRET_PREVIOUS=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# 64 caracteres hexadecimales. Cifra las credenciales que se guardan desde el
# panel: si se pierde, las integraciones hay que volver a configurarlas todas.
# Guárdala aparte, fuera del servidor.
ENCRYPTION_KEY=  # openssl rand -hex 32

# Autoriza la revalidación de páginas de la tienda desde la API.
REVALIDATE_SECRET=  # openssl rand -base64 32
# Protege /metrics para que la operativa del negocio no sea pública.
METRICS_TOKEN=  # openssl rand -base64 32

# ── Tienda ────────────────────────────────────────────────────
DEFAULT_LOCALE=es
SUPPORTED_LOCALES=es,ca,en
DEFAULT_CURRENCY=EUR
DEFAULT_COUNTRY=ES

# La dirección pública de la tienda, con https y sin barra final.
#
# De aquí salen el canonical, los hreflang, el sitemap y las imágenes de Open
# Graph. Mal puesta, Google ignora los hreflang y el sitemap anuncia
# direcciones que no existen.
SITE_URL=https://tudominio.es

# ── Correo saliente ───────────────────────────────────────────
#
# ESTO FALTABA, y el síntoma es de los que no avisan: sin ello la tienda no
# manda NI UN correo —ni confirmación de pedido, ni aviso de envío, ni
# recuperación de contraseña— y no falla nada por fuera. Los pedidos se cobran
# y se sirven igual; simplemente el cliente no recibe nada.
#
# Se puede terminar de configurar en el panel (Ajustes → Integraciones), pero
# poniéndolo aquí queda listo desde el primer arranque.
#
# El remitente TIENE que ser del dominio verificado en el servicio de envío:
# con un @gmail.com los correos se rechazan de entrada. Y hace falta configurar
# SPF, DKIM y DMARC en el DNS del dominio, o irán a spam aunque salgan.
SMTP_HOST=          # smtp.resend.com, smtp-relay.brevo.com…
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false   # lo decide el puerto (465 cifrado, 587 STARTTLS); solo cuenta en puertos raros
MAIL_FROM=Tienda <no-reply@tudominio.es>

# ── Observabilidad ────────────────────────────────────────────
LOG_LEVEL=info
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
GRAFANA_PASSWORD=  # openssl rand -base64 24

# ── Límites ───────────────────────────────────────────────────
THROTTLE_LIMIT=100
THROTTLE_TTL_MS=60000
